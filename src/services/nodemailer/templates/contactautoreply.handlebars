<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>We've received your message</title>
    <style
    >
      body { font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 0; padding: 0; }
      .container { max-width: 600px; margin: 30px auto; background: #ffffff; padding: 24px; border-radius: 8px; box-shadow: 0px 4px 10px rgba(0,0,0,0.08); }
      .header { text-align: center; padding-bottom: 12px; }
      .header img { max-width: 160px; }
      .bar { height: 4px; border-radius: 4px; margin: 8px 0 20px; background: {{#if
        primaryColor
      }}{{primaryColor}}{{else}}#4f46e5{{/if}}; }
      h2 { color: #222; margin-top: 0; }
      p { color: #555; font-size: 15px; line-height: 1.6; }
      .quote { background: #f7f9fc; border-left: 4px solid {{#if
        primaryColor
      }}{{primaryColor}}{{else}}#4f46e5{{/if}}; padding: 14px 16px; border-radius: 4px; color: #444; white-space: pre-wrap; margin: 16px 0; }
      .footer { margin-top: 28px; font-size: 12px; color: #999; }
      .footer a { color: #777; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">
        {{#if logoUrl}}<img
            src="{{logoUrl}}"
            alt="{{companyName}} logo"
          />{{/if}}
      </div>
      <div class="bar"></div>

      <h2>Hi {{name}}</h2>

      {{#if autoReplyMessage}}
        <p>{{autoReplyMessage}}</p>
      {{else}}
        <p>We've received your message and a member of the
          {{companyName}}
          team will get back to you as soon as possible.</p>
      {{/if}}

      <p><strong>Here's a copy of what you sent us:</strong></p>
      <div class="quote">{{message}}</div>

      <p>Warm regards,<br />The {{companyName}} Team</p>

      <div class="footer">
        <p>This is an automated confirmation. You don't need to reply.</p>
        {{#if supportEmail}}<p>Need help sooner? Contact us at
            <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.</p>{{/if}}
      </div>
    </div>
  </body>
</html>