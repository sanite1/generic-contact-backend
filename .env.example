# ── Core ──
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/contact-backend
JWT_SECRET=change-me

# ── Default SMTP transport ──
# Used whenever a company profile has no SMTP credentials of its own.
AUTH_EMAIL=you@yourdomain.com
AUTH_PASS=your-smtp-password
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
DEFAULT_FROM_NAME=Contact

# ── CORS (comma-separated allowlist) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting (optional overrides) ──
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=300000

# ── Seed admin (used by `npm run seed`) ──
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRSTNAME=Admin
SEED_ADMIN_LASTNAME=User
SEED_ADMIN_PHONE=0000000000

# ── Optional: used only by the inherited user/auth feature ──
DOMAIN_NAME=http://localhost:5173
CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
